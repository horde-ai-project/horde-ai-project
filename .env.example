# Copy to .env and fill in locally. Never commit .env or real secrets.
# HORDE_PASSPHRASE is required to start the binary.
# Launcher scripts (scripts/horde-start.*) source this file when present.

HORDE_PASSPHRASE=
HORDE_DATA_DIR=./horde-data
HORDE_HOSTNAME=localhost
HORDE_BIND=127.0.0.1:8787
# Optional path to operator UI static assets (default: ./ui next to the repo)
# HORDE_UI_DIR=./ui
# Optional: set 1 to open the system browser when using start scripts
# HORDE_OPEN_BROWSER=0
# Optional invite-bounded mesh listener:
# HORDE_MESH_BIND=127.0.0.1:9797
# HORDE_BOOTSTRAP_PEERS=127.0.0.1:9797
# HORDE_PUBLIC_DHT=0
